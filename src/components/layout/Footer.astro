---
import { CONTACT, LINKS, SITE } from '../../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 px-6 py-16">
  <div class="mx-auto grid max-w-7xl gap-12 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl">Salu Produções</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream/60">
        Fotografia e filme de casamento. Um registro honesto, bem conduzido e pensado para atravessar o tempo.
      </p>
    </div>

    <div>
      <p class="label mb-4">Contato</p>
      <ul class="space-y-2 text-sm text-cream/70">
        <li>
          <a class="hover:text-champagne" href={LINKS.whatsapp} target="_blank" rel="noopener">
            WhatsApp {CONTACT.whatsappDisplay}
          </a>
        </li>
        <li>
          <a class="hover:text-champagne" href={LINKS.instagram} target="_blank" rel="noopener">
            Instagram @{CONTACT.instagram}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="label mb-4">Atendimento</p>
      <p class="text-sm text-cream/70">{CONTACT.area}</p>
      <p class="mt-4 text-sm text-cream/40">© {year} {SITE.name}. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
