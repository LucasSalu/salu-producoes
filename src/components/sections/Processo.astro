---
const passos = [
  {
    n: '01',
    titulo: 'Conversa',
    texto: 'Entendemos a história de vocês, a data e o que não pode faltar no grande dia.',
  },
  {
    n: '02',
    titulo: 'Proposta',
    texto: 'Pacote sob medida, escopo claro e contrato sem surpresas.',
  },
  {
    n: '03',
    titulo: 'Pré-wedding',
    texto: 'Um ensaio para vocês se acostumarem com a câmera e já saírem com fotos lindas.',
  },
  {
    n: '04',
    titulo: 'O grande dia',
    texto: 'Cobertura discreta, do making of ao último abraço. Sem interferir no que importa.',
  },
  {
    n: '05',
    titulo: 'Entrega',
    texto: 'Seleção e edição premium, galeria online e o álbum para passar de mão em mão.',
  },
];
---

<section id="processo" class="px-6 py-24 md:py-32">
  <div class="mx-auto max-w-7xl">
    <p class="label mb-4" data-reveal>04 · Processo</p>
    <h2
      class="max-w-2xl text-balance font-display text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] tracking-[-0.01em]"
      data-reveal
    >
      Do primeiro "oi" ao álbum na estante.
    </h2>

    <div class="mt-14 grid gap-px border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-5" data-reveal-group>
      {passos.map((passo) => (
        <article class="group bg-bg p-6 transition-colors hover:bg-surface">
          <p class="font-display text-4xl text-gold/70 transition-colors group-hover:text-gold">
            {passo.n}
          </p>
          <h3 class="mt-6 font-display text-xl">{passo.titulo}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream/60">{passo.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
