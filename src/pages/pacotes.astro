---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import Pacotes from '../components/sections/Pacotes.astro';
import { LINKS } from '../consts';
---

<Base
  title="Pacotes e investimento | Salu Produções"
  description="Pacotes de fotografia e filme de casamento: Bronze, Prata, Ouro e Promoção. Valores e o que está incluso."
>
  <Header />

  <main class="pt-32">
    <Pacotes />

    <section class="px-6 pb-24 text-center">
      <div class="mx-auto max-w-2xl">
        <p class="label mb-4">Próximo passo</p>
        <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight">
          Conte a data do seu casamento.
        </h2>
        <p class="mt-5 text-cream/60">
          Respondemos em até 24 h úteis com uma proposta sob medida.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href="/orcamento" class="btn btn-gold">Solicitar orçamento</a>
          <a href={LINKS.instagram} target="_blank" rel="noopener" class="btn btn-ghost">
            Ver no Instagram
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Base>
