---
import Base from '../layouts/Base.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';
import { fotos, srcset, fallback, alt, largest } from '../lib/fotos';
---

<Base
  title="Portfólio | Salu Produções"
  description="Casamentos reais fotografados pela Salu Produções em Paulínia e todo o estado de São Paulo."
>
  <Header />

  <main class="pt-36">
    <section class="px-6 pb-14">
      <div class="mx-auto max-w-7xl" data-reveal>
        <p class="label mb-4">Portfólio</p>
        <h1 class="text-balance font-display text-[clamp(2.4rem,5vw,4.2rem)] leading-tight">
          Casais reais, histórias que ficam.
        </h1>
        <p class="mt-5 max-w-xl text-cream/60">
          {fotos.length} registros de casamentos e ensaios. Clique em qualquer foto para ver
          em tela cheia.
        </p>
      </div>
    </section>

    <section class="px-6 pb-24">
      <div
        id="galeria"
        class="mx-auto max-w-7xl columns-2 gap-3 md:columns-3 lg:columns-4"
        data-reveal-group
      >
        {fotos.map((foto) => (
          <a
            href={largest(foto)}
            data-pswp-width={foto.w}
            data-pswp-height={foto.h}
            target="_blank"
            rel="noopener"
            class="group mb-3 block break-inside-avoid overflow-hidden"
          >
            <img
              src={fallback(foto, 960)}
              srcset={srcset(foto)}
              sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
              alt={alt(foto)}
              class="w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />

  <script>
    import '../scripts/lightbox';
  </script>
</Base>
